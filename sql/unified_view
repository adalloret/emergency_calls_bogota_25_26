CREATE OR REPLACE VIEW `mi-biblioteca-502619.salud_linea123.vw_incidencia_historica` AS 
WITH unified_base AS (
  SELECT
    _TABLE_SUFFIX AS year_month_source,
    SAFE_CAST(NUMERO_INCIDENTE AS STRING) AS incident_id,
    
    -- Se convierte primero a STRING para resolver el conflicto entre TIMESTAMP y STRING entre tablas
    SAFE_CAST(CAST(FECHA_INICIO_DESPLAZAMIENTO_MOVIL AS STRING) AS TIMESTAMP) AS dispatch_timestamp,

-- Estandarización y limpieza estricta de las 20 localidades de Bogotá
  CASE 
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%FUERA%' 
        OR UPPER(TRIM(LOCALIDAD)) LIKE '%BOGOTM%' 
        OR UPPER(TRIM(LOCALIDAD)) LIKE '%BOGOTA%' THEN 'FUERA DE BOGOTÁ'
     
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%ENGATIV%' THEN 'ENGATIVÁ'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%USAQU%' THEN 'USAQUÉN'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%BOL%' THEN 'CIUDAD BOLÍVAR'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%CRIST%' THEN 'SAN CRISTÓBAL'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%FONTIB%' THEN 'FONTIBÓN'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%CHAPIN%' THEN 'CHAPINERO'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%SANTA FE%' OR UPPER(TRIM(LOCALIDAD)) LIKE '%SANTAFE%' THEN 'SANTA FE'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%USME%' THEN 'USME'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%TUNJUEL%' THEN 'TUNJUELITO'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%BOSA%' THEN 'BOSA'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%KENNEDY%' THEN 'KENNEDY'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%SUBA%' THEN 'SUBA'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%BARRIOS UNIDOS%' THEN 'BARRIOS UNIDOS'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%TEUSAQU%' THEN 'TEUSAQUILLO'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%M%RTIRES%' THEN 'LOS MÁRTIRES'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%ANTONIO NARI%' THEN 'ANTONIO NARIÑO'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%PUENTE ARANDA%' THEN 'PUENTE ARANDA'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%CANDELAR%' THEN 'LA CANDELARIA'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%RAFAEL URIBE%' THEN 'RAFAEL URIBE URIBE'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%SUMAPAZ%' THEN 'SUMAPAZ'
      WHEN UPPER(TRIM(LOCALIDAD)) LIKE '%BOGOTM%' THEN 'BOGOTÁ'
      ELSE COALESCE(UPPER(TRIM(LOCALIDAD)), 'NO REGISTRADO')
    END AS locality,

    SAFE_CAST(EDAD AS FLOAT64) AS age,
    UPPER(TRIM(UNIDAD)) AS age_unit,
    UPPER(TRIM(GENERO)) AS gender,
    UPPER(TRIM(TIPO_INCIDENTE)) AS incident_type,
    CASE 
      WHEN UPPER(TRIM(CAST(PRIORIDAD_FINAL AS STRING))) IN ('CRITICA', 'CRÍTICA', '1') THEN 'HIGH/CRITICAL'
      WHEN UPPER(TRIM(CAST(PRIORIDAD_FINAL AS STRING))) IN ('ALTA', 'ALTO', '2') THEN 'HIGH'
      WHEN UPPER(TRIM(CAST(PRIORIDAD_FINAL AS STRING))) IN ('MEDIA', 'MEDIO', '3') THEN 'MEDIUM'
      WHEN UPPER(TRIM(CAST(PRIORIDAD_FINAL AS STRING))) IN ('BAJA', 'BAJO', '4') THEN 'LOW'
      
      ELSE COALESCE(UPPER(TRIM(CAST(PRIORIDAD_FINAL AS STRING))), 'UNKNOWN')
    END AS final_priority,
    SAFE_CAST(CAST(RECEPCION AS STRING) AS TIMESTAMP) AS reception_timestamp
  FROM `mi-biblioteca-502619.salud_linea123.stg_incidentes_*`
  WHERE CAST(NUMERO_INCIDENTE AS STRING) NOT LIKE '%INCIDENTE%'
    AND CAST(NUMERO_INCIDENTE AS STRING) NOT LIKE '%NUMERO%'
)
SELECT
  *,
  TIMESTAMP_DIFF(reception_timestamp, dispatch_timestamp, MINUTE) AS latency_minutes,
  EXTRACT(YEAR FROM dispatch_timestamp) AS year,
  EXTRACT(MONTH FROM dispatch_timestamp) AS month,
  FORMAT_TIMESTAMP('%A', dispatch_timestamp) AS day_of_week,
  EXTRACT(HOUR FROM dispatch_timestamp) AS hour_of_day,
  CASE
    WHEN EXTRACT(HOUR FROM dispatch_timestamp) BETWEEN 0 AND 5 THEN 'night'
    WHEN EXTRACT(HOUR FROM dispatch_timestamp) BETWEEN 6 AND 11 THEN 'morning'
    WHEN EXTRACT(HOUR FROM dispatch_timestamp) BETWEEN 12 AND 17 THEN 'afternoon'
    ELSE 'evening'
  END AS shift_period,

  CASE
    WHEN FORMAT_TIMESTAMP('%A', dispatch_timestamp) IN ('Saturday', 'Sunday') THEN TRUE
    ELSE FALSE
  END AS is_weekend,

  CASE 
    WHEN age_unit IN ('MESES', 'DIAS') OR (age_unit = 'AÑOS' AND age < 6) THEN 'early_childhood'
    WHEN age BETWEEN 6 AND 11 THEN 'childhood'
    WHEN age BETWEEN 12 AND 17 THEN 'adolescence'
    WHEN age BETWEEN 18 AND 59 THEN 'adulthood'
    WHEN age >= 60 THEN 'senior'
    ELSE 'unknown'
  END AS age_group,

  CASE WHEN reception_timestamp IS NULL THEN TRUE ELSE FALSE END AS is_missing_reception,
  CASE WHEN age IS NULL OR gender IS NULL THEN TRUE ELSE FALSE END AS is_missing_demographic,
  CASE WHEN TIMESTAMP_DIFF(reception_timestamp, dispatch_timestamp, MINUTE) > 360 THEN TRUE ELSE FALSE END AS is_extreme_latency_6h,
  CASE WHEN TIMESTAMP_DIFF(reception_timestamp, dispatch_timestamp, MINUTE) < 0 THEN TRUE ELSE FALSE END AS is_time_inconsistency

FROM unified_base;
